# 复制成 .env.local 后按需修改（.env.local 不进 git）
#
# 优先级：环境变量 > .env.local > 内置默认值
# 启动日志会打印"每个值从哪来"，不用猜。

# PostgreSQL 连接串。默认指向 scripts/devdb.ps1 起的便携实例。
QINYUAN_DSN=postgres://postgres@127.0.0.1:55432/qinyuan?sslmode=disable

# 测试库（go test 用；每个测试建独立 schema）
# QINYUAN_TEST_DSN=postgres://postgres@127.0.0.1:55432/qinyuan_test?sslmode=disable

# 数据目录（工具输出落盘、后续的流量/证据都放这里），会转成绝对路径
QINYUAN_DATA_DIR=./data

# HTTP API 监听地址
QINYUAN_ADDR=127.0.0.1:8787

# ---- 鉴权（M9，见 docs/17）----
# auto（默认）：配了令牌就启用；on：没令牌拒绝启动；off：监听非回环会拒绝启动。
QINYUAN_AUTH=auto
# 单令牌（默认 admin）。监听非回环地址时**必须**配置，否则 serve 直接拒绝启动。
# 建议用 32+ 字符随机串：openssl rand -hex 24
QINYUAN_AUTH_TOKEN=
# 多令牌带角色（与上面可同时用，逗号分隔）：token:viewer,token2:operator,token3:admin
QINYUAN_AUTH_TOKENS=
# 会话时长（小时，1..168）。会话在内存，重启即全员登出。
QINYUAN_SESSION_TTL_HOURS=12
# 反代 + HTTPS 时设 1（会话 cookie 只走 TLS）
QINYUAN_COOKIE_SECURE=0

# 允许 HTTP 工具访问回环地址。默认 0（拒绝）。
# 只在本地 demo / 自测时开成 1 —— 它会削弱 SSRF 防护。
QINYUAN_ALLOW_LOOPBACK=0

# 单次工具输出上限（字符）；超过会落盘并只回 head + 指针
QINYUAN_MAX_TOOL_OUTPUT=30000

# worker 单次执行的回合上限 / 时长上限
QINYUAN_MAX_TURNS=12
QINYUAN_TIMEOUT_SECONDS=600

# ---- 模型接入（M2）----
# fake = 不调真实模型（跑测试/空跑链路）；openai = OpenAI Chat Completions 兼容后端
QINYUAN_LLM_PROVIDER=fake
# 兼容 DeepSeek / OpenAI / 自建网关 / vLLM；注意结尾不要带 /chat/completions
QINYUAN_LLM_BASE_URL=https://api.deepseek.com/v1
QINYUAN_LLM_API_KEY=
QINYUAN_LLM_MODEL=deepseek-chat
QINYUAN_LLM_MAX_TOKENS=4096
QINYUAN_LLM_TEMPERATURE=0.2
QINYUAN_LLM_TIMEOUT_SECONDS=120
QINYUAN_LLM_MAX_RETRIES=2

# 单个附件上限（MB，1..512）。任务附件放在 data/runs/<id>/attachments/（内容寻址）
QINYUAN_MAX_UPLOAD_MB=32
# ---- 执行沙箱（M17，默认关闭；需要 WSL2 + Docker）----
# off = 不启用（worker 没有 exec 工具）；on = 启用并在启动时自检 WSL+Docker。
QINYUAN_SANDBOX=off
QINYUAN_SANDBOX_DISTRO=Ubuntu-24.04
QINYUAN_SANDBOX_IMAGE=qinyuan/sandbox:latest
QINYUAN_SANDBOX_NETWORK=qy-sandbox
QINYUAN_SANDBOX_SUBNET=10.201.0.0/24
QINYUAN_SANDBOX_JOBROOT=/var/lib/qinyuan/jobs
QINYUAN_SANDBOX_TIMEOUT_SECONDS=120
# 建任务时没给 timeout 的默认墙钟（秒）：0 = 不限。CTF 类任务默认 45 分钟
# （run #43 实测：20 分钟里前 12 分钟都在读源码，不够造载荷）
QINYUAN_DEFAULT_TASK_TIMEOUT_SECONDS=2700